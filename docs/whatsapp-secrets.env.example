# POUR LE FORMULAIRE A DEUX CHAMPS : voir whatsapp-secrets-guide.fr.md ; ne pas saisir les signes =.
# EXEMPLE UNIQUEMENT POUR IMPORT .env : remplacer les valeurs avant import dans Supabase Secrets.
# Ne jamais committer un fichier contenant les vraies valeurs.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_META_WABA_ID
WHATSAPP_GRAPH_VERSION=REPLACE_WITH_SUPPORTED_GRAPH_VERSION_FROM_META
WHATSAPP_TEMPLATE_LANGUAGE=fr
